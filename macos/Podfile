platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

# 정적 라이브러리 사용 대신에 use_frameworks! 사용
use_frameworks! :linkage => :static

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # gRPC 모듈맵 파일 생성
  grpc_public_headers = File.join(Dir.pwd, 'Pods', 'Headers', 'Public', 'gRPC-Core')
  grpc_private_headers = File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc')
  boringssl_public_headers = File.join(Dir.pwd, 'Pods', 'Headers', 'Public', 'BoringSSL-GRPC')
  boringssl_private_headers = File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'openssl_grpc')
  
  FileUtils.mkdir_p(grpc_public_headers)
  FileUtils.mkdir_p(grpc_private_headers)
  FileUtils.mkdir_p(boringssl_public_headers)
  FileUtils.mkdir_p(boringssl_private_headers)
  
  grpc_public_modulemap = File.join(grpc_public_headers, 'gRPC-Core.modulemap')
  grpc_private_modulemap = File.join(grpc_private_headers, 'gRPC-Core.modulemap')
  boringssl_public_modulemap = File.join(boringssl_public_headers, 'BoringSSL-GRPC.modulemap')
  boringssl_private_modulemap = File.join(boringssl_private_headers, 'BoringSSL-GRPC.modulemap')
  
  # GRPC 모듈맵 파일 내용
  grpc_modulemap_content = <<~MAP
    module gRPC_Core {
      umbrella header "grpc.h"
      export *
      module * { export * }
    }
  MAP
  
  # BoringSSL 모듈맵 파일 내용
  boringssl_modulemap_content = <<~MAP
    module BoringSSL_GRPC {
      umbrella header "openssl.h"
      export *
      module * { export * }
    }
  MAP
  
  # 모듈맵 파일 생성
  File.open(grpc_public_modulemap, 'w') do |f|
    f.puts grpc_modulemap_content
  end
  
  File.open(grpc_private_modulemap, 'w') do |f|
    f.puts grpc_modulemap_content
  end
  
  File.open(boringssl_public_modulemap, 'w') do |f|
    f.puts boringssl_modulemap_content
  end
  
  File.open(boringssl_private_modulemap, 'w') do |f|
    f.puts boringssl_modulemap_content
  end
  
  puts "✅ gRPC-Core.modulemap 및 BoringSSL-GRPC.modulemap 수동 생성 완료"
end
