<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Watch Over</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>watch_over</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Google 로그인을 위한 URL 스키마 설정 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- 이 값은 GoogleService-Info.plist 파일의 REVERSED_CLIENT_ID 값과 일치해야 합니다 -->
				<string>com.googleusercontent.apps.1071355933777-m1i508qebs4no0fm10on2et5q61mbjig</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.maccrey.watch_over</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>watchover</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>googleauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.1071355933777-m1i508qebs4no0fm10on2et5q61mbjig</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- URL 스킴 권한 -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tel</string>
		<string>sms</string>
		<string>https</string>
		<string>http</string>
		<string>googlechrome</string>
		<string>googlechrome-x-callback</string>
		<string>hasgoogledeviceowner</string>
		<string>com.google.gpsonlineassistant</string>
		<string>googleauth</string>
		<string>google</string>
		<string>googleauthentication</string>
		<string>googlesignin</string>
		<string>com.googleusercontent.apps</string>
	</array>
	<!-- 위치 권한 설명 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>지도 표시, 현재 위치 추적 및 경로 안내를 위해 위치 정보가 필요합니다.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>백그라운드에서 위치 추적 및 경로 탐색을 위해 항상 위치 정보가 필요합니다.</string>
	<!-- Google Maps API 키 -->
	<key>io.flutter.embedded_views_preview</key>
	<true/>
	<key>GoogleMapsApiKey</key>
	<string>$(GOOGLE_MAPS_API_KEY)</string>
	<!-- 오디오 사용 설명 -->
	<key>NSMicrophoneUsageDescription</key>
	<string>SOS 긴급 상황 시 알림음 재생을 위해 사용됩니다.</string>
	
	<!-- 카메라 접근 권한 -->
	<key>NSCameraUsageDescription</key>
	<string>프로필 사진 촬영을 위해 카메라 접근 권한이 필요합니다.</string>
	
	<!-- 사진 라이브러리 접근 권한 -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>프로필 사진 선택을 위해 사진 라이브러리 접근 권한이 필요합니다.</string>
	
	<!-- 네트워크 관련 설정 -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
