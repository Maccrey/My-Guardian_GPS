# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# 정적 라이브러리 사용
use_modular_headers!
# use_frameworks!

target 'Runner' do
  # Firestore 프리컴파일된 바이너리 사용
  pod 'FirebaseFirestore', :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git', :tag => '10.25.0'
  
  # Firebase Storage 문제 해결을 위한 설정
  # pod 'FirebaseStorage', :modular_headers => true
  
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'GoogleMaps'
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 모든 타겟에 대해 아키텍처 설정
    target.build_configurations.each do |config|
      # 시뮬레이터용 arm64 제외
      if config.build_settings['SDKROOT'] == 'iphonesimulator'
        config.build_settings['EXCLUDED_ARCHS'] = 'arm64'
      end
      
      # Swift 버전 설정
      config.build_settings['SWIFT_VERSION'] = '5.0'
      
      # 호환성 설정
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
    end
  end
  
  # gRPC 모듈맵 파일 생성 - 강화된 버전
  grpc_dirs = [
    { public: File.join(Dir.pwd, 'Pods', 'Headers', 'Public', 'gRPC-Core'), 
      private: File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc') },
    { public: File.join(Dir.pwd, 'Pods', 'gRPC-Core', 'include'), 
      private: File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc') },
    { public: File.join(Dir.pwd, 'Pods', 'Headers', 'Public', 'grpc'), 
      private: File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc') }
  ]
  
  # 모듈맵 파일 내용
  modulemap_content = <<~MAP
    module gRPC_Core {
      umbrella header "grpc.h"
      export *
      module * { export * }
    }
  MAP
  
  # 여러 경로에 모듈맵 파일 생성 시도
  grpc_dirs.each do |dirs|
    FileUtils.mkdir_p(dirs[:public])
    FileUtils.mkdir_p(dirs[:private])
    
    grpc_public_modulemap = File.join(dirs[:public], 'gRPC-Core.modulemap')
    grpc_private_modulemap = File.join(dirs[:private], 'gRPC-Core.modulemap')
    
    # 모듈맵 파일 생성
    File.open(grpc_public_modulemap, 'w') do |f|
      f.puts modulemap_content
    end
    
    # 프라이빗 폴더에도 복사
    File.open(grpc_private_modulemap, 'w') do |f|
      f.puts modulemap_content
    end
    
    # 셸 명령어로도 직접 생성 시도
    system("mkdir -p #{dirs[:private]}")
    system("echo '#{modulemap_content}' > #{grpc_private_modulemap}")
    
    puts "✅ gRPC-Core.modulemap 생성 시도: #{dirs[:private]}"
  end
  
  # 빌드 설정에 gRPC 관련 설정 추가
  installer.pods_project.targets.each do |target|
    if target.name == 'gRPC-Core'
      target.build_configurations.each do |config|
        # 모듈맵 파일 경로 설정
        config.build_settings['MODULEMAP_FILE'] = File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc', 'gRPC-Core.modulemap')
        # 헤더 검색 경로 추가
        if config.build_settings['HEADER_SEARCH_PATHS'].nil?
          config.build_settings['HEADER_SEARCH_PATHS'] = ['$(inherited)', "#{Dir.pwd}/Pods/Headers/Private/grpc"]
        else
          config.build_settings['HEADER_SEARCH_PATHS'] << "#{Dir.pwd}/Pods/Headers/Private/grpc"
        end
      end
    end
  end
  
  # 시스템 명령어로 모듈맵 파일 확인
  system("ls -la #{File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'grpc')}")
  
  # Firestore 관련 설정 추가
  firestore_internal_headers = File.join(Dir.pwd, 'Pods', 'FirebaseFirestoreInternal')
  if Dir.exist?(firestore_internal_headers)
    puts "✅ FirebaseFirestoreInternal 폴더 존재함"
    
    # FirebaseFirestoreInternal 모듈맵 파일 생성
    firestore_internal_modulemap = File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'FirebaseFirestoreInternal', 'FirebaseFirestoreInternal.modulemap')
    firestore_internal_modulemap_dir = File.join(Dir.pwd, 'Pods', 'Headers', 'Private', 'FirebaseFirestoreInternal')
    
    # 디렉토리 생성
    FileUtils.mkdir_p(firestore_internal_modulemap_dir)
    
    # 모듈맵 내용
    firestore_modulemap_content = <<~MAP
      framework module FirebaseFirestoreInternal {
        umbrella header "FirebaseFirestoreInternal-umbrella.h"
        export *
        module * { export * }
      }
    MAP
    
    # 모듈맵 파일 생성
    File.open(firestore_internal_modulemap, 'w') do |f|
      f.puts firestore_modulemap_content
    end
    
    # 원본 모듈맵 파일 경로
    source_modulemap = File.join(Dir.pwd, 'Pods', 'Target Support Files', 'FirebaseFirestoreInternal', 'FirebaseFirestoreInternal.modulemap')
    
    # 원본 모듈맵 파일이 있는지 확인하고 복사
    if File.exist?(source_modulemap)
      FileUtils.cp(source_modulemap, firestore_internal_modulemap)
      puts "✅ FirebaseFirestoreInternal.modulemap 파일 복사됨"
    end
    
    # 빌드 설정 수정
    installer.pods_project.targets.each do |target|
      if target.name == 'FirebaseFirestoreInternal'
        target.build_configurations.each do |config|
          # 모듈맵 파일 경로 설정
          config.build_settings['MODULEMAP_FILE'] = firestore_internal_modulemap
          # 헤더 검색 경로 추가
          if config.build_settings['HEADER_SEARCH_PATHS'].nil?
            config.build_settings['HEADER_SEARCH_PATHS'] = ['$(inherited)', "#{Dir.pwd}/Pods/Headers/Private/FirebaseFirestoreInternal"]
          else
            config.build_settings['HEADER_SEARCH_PATHS'] << "#{Dir.pwd}/Pods/Headers/Private/FirebaseFirestoreInternal"
          end
        end
      end
    end
    
    puts "✅ FirebaseFirestoreInternal 설정 완료"
  else
    puts "⚠️ FirebaseFirestoreInternal 폴더가 없음"
  end
  
  puts "✅ gRPC-Core.modulemap 수동 생성 완료"
end
